<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>7DAYZ Prototype</title>

<style>
/* ==============================
   BASIC
================================ */

* {
  box-sizing: border-box;
}

:root {
  --bg: #0d1012;
  --panel: #14181b;
  --panel-hover: #1a2024;

  --line: #30373c;
  --line-light: #596168;

  --text: #e7e9e9;
  --sub: #858d92;
  --dim: #555e63;
}

html,
body {
  margin: 0;
  min-height: 100%;
}

body {
  background: var(--bg);
  color: var(--text);

  font-family:
    "Pretendard",
    "Noto Sans KR",
    Arial,
    sans-serif;
}


/* ==============================
   SCREEN SYSTEM
================================ */

.screen {
  display: none;

  width: 100%;
  min-height: 100vh;
}

.screen.active {
  display: flex;
}


/* ==============================
   TITLE
================================ */

#title-screen {
  align-items: center;
  justify-content: center;

  text-align: center;

  background:
    linear-gradient(
      180deg,
      #101416 0%,
      #090b0c 100%
    );
}

.title-wrap {
  padding: 30px;
}

.title-code {
  margin-bottom: 18px;

  color: var(--dim);

  font-size: 10px;
  letter-spacing: 5px;
}

.title {
  margin: 0;

  font-size: clamp(52px, 10vw, 100px);
  font-weight: 300;

  letter-spacing: 12px;
}

.title-cn {
  margin-top: 14px;

  color: var(--sub);

  font-size: 13px;
  letter-spacing: 7px;
}

.start-btn {
  width: 230px;

  margin-top: 70px;
  padding: 15px;

  border: 1px solid var(--line-light);

  background: transparent;
  color: var(--text);

  font-size: 11px;
  letter-spacing: 5px;

  cursor: pointer;

  transition: .2s;
}

.start-btn:hover {
  background: var(--text);
  color: var(--bg);
}


/* ==============================
   COMMON PAGE
================================ */

.page {
  flex-direction: column;

  width: 100%;
  max-width: 1200px;

  min-height: 100vh;

  margin: auto;
  padding: 34px;
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;

  padding-bottom: 18px;

  border-bottom: 1px solid var(--line);
}

.brand-small {
  font-size: 12px;
  letter-spacing: 4px;
}

.system {
  color: var(--dim);

  font-size: 9px;
  letter-spacing: 3px;
}


/* ==============================
   LOBBY
================================ */

.lobby-heading {
  margin-top: 70px;
}

.label {
  color: var(--sub);

  font-size: 10px;
  letter-spacing: 4px;
}

.team {
  margin-top: 8px;

  font-size: clamp(34px, 6vw, 58px);
  font-weight: 300;

  letter-spacing: 8px;
}

.team-en {
  margin-top: 8px;

  color: var(--dim);

  font-size: 10px;
  letter-spacing: 5px;
}


.menu-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);

  gap: 10px;

  width: 100%;
  max-width: 800px;

  margin: auto;
}

.menu {
  position: relative;

  min-height: 150px;

  padding: 25px;

  border: 1px solid var(--line);

  background: var(--panel);
  color: var(--text);

  text-align: left;

  cursor: pointer;

  transition: .2s;
}

.menu:hover {
  background: var(--panel-hover);
  border-color: var(--line-light);

  transform: translateY(-2px);
}

.menu-number {
  position: absolute;

  top: 18px;
  right: 20px;

  color: var(--dim);

  font-size: 9px;
}

.menu-ko {
  display: block;

  margin-top: 40px;

  font-size: 20px;
}

.menu-en {
  display: block;

  margin-top: 7px;

  color: var(--sub);

  font-size: 9px;
  letter-spacing: 3px;
}


/* ==============================
   ROSTER
================================ */

.page-title {
  margin: 45px 0 8px;

  font-size: 30px;
  font-weight: 400;

  letter-spacing: 5px;
}

.page-description {
  margin-bottom: 35px;

  color: var(--sub);

  font-size: 12px;
}


.roster {
  display: grid;
  grid-template-columns: repeat(5, 1fr);

  gap: 9px;

  width: 100%;
}


.agent {
  min-height: 330px;

  padding: 0;

  overflow: hidden;

  border: 1px solid var(--line);

  background: var(--panel);
  color: var(--text);

  text-align: left;

  cursor: pointer;

  transition: .2s;
}

.agent:hover {
  transform: translateY(-4px);

  border-color: var(--line-light);

  background: var(--panel-hover);
}


/* 나중에 캐릭터 이미지가 들어갈 자리 */

.portrait {
  height: 190px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-bottom: 1px solid var(--line);

  background:
    linear-gradient(
      145deg,
      #20262a,
      #111416
    );

  color: #3e474c;

  font-size: 42px;
  font-family: serif;
}


.agent-info {
  padding: 17px;
}

.agent-type {
  color: var(--sub);

  font-size: 9px;
  letter-spacing: 2px;
}

.agent-name {
  margin-top: 12px;

  font-size: 21px;
  letter-spacing: 3px;
}

.agent-real {
  margin-top: 5px;

  color: var(--sub);

  font-size: 11px;
}


/* ==============================
   BACK BUTTON
================================ */

.back {
  margin-top: auto;
  padding-top: 40px;
}

.back-btn {
  padding: 10px 18px;

  border: 1px solid var(--line);

  background: transparent;
  color: var(--sub);

  font-size: 10px;
  letter-spacing: 3px;

  cursor: pointer;
}

.back-btn:hover {
  border-color: var(--line-light);
  color: var(--text);
}


/* ==============================
   PLACEHOLDER
================================ */

.placeholder {
  flex: 1;

  display: flex;
  align-items: center;
  justify-content: center;

  color: var(--dim);

  font-size: 11px;
  letter-spacing: 3px;
}


/* ==============================
   MOBILE
================================ */

@media (max-width: 850px) {

  .roster {
    grid-template-columns: repeat(2, 1fr);
  }

}


@media (max-width: 600px) {

  .page {
    padding: 20px 16px;
  }

  .lobby-heading {
    margin-top: 40px;
  }

  .menu-grid {
    grid-template-columns: 1fr;

    margin-top: 50px;
  }

  .menu {
    min-height: 110px;
  }

  .menu-ko {
    margin-top: 20px;
  }

  .roster {
    grid-template-columns: 1fr;
  }

  .agent {
    min-height: auto;
  }

  .portrait {
    height: 150px;
  }

  .system {
    display: none;
  }

}

</style>
</head>


<body>


<!-- =========================================
     TITLE
========================================= -->

<section
  id="title"
  class="screen active"
>

  <div class="title-wrap">

    <div class="title-code">
      OFFICIAL FIELD SYSTEM
    </div>

    <h1 class="title">
      7DAYZ
    </h1>

    <div class="title-cn">
      七曜管理局
    </div>

    <button
      class="start-btn"
      onclick="showScreen('lobby')"
    >
      START
    </button>

  </div>

</section>



<!-- =========================================
     LOBBY
========================================= -->

<section
  id="lobby"
  class="screen page"
>

  <header class="topbar">

    <div class="brand-small">
      七曜管理局
    </div>

    <div class="system">
      FIELD TERMINAL / ONLINE
    </div>

  </header>


  <div class="lobby-heading">

    <div class="label">
      FIELD TEAM 01
    </div>

    <div class="team">
      反影
    </div>

    <div class="team-en">
      FIELD TEAM 1
    </div>

  </div>


  <div class="menu-grid">

    <button
      class="menu"
      onclick="showScreen('roster')"
    >

      <span class="menu-number">
        01
      </span>

      <span class="menu-ko">
        인물
      </span>

      <span class="menu-en">
        PERSONNEL
      </span>

    </button>


    <button
      class="menu"
      onclick="showScreen('formation')"
    >

      <span class="menu-number">
        02
      </span>

      <span class="menu-ko">
        편성
      </span>

      <span class="menu-en">
        FORMATION
      </span>

    </button>


    <button
      class="menu"
      onclick="showScreen('case')"
    >

      <span class="menu-number">
        03
      </span>

      <span class="menu-ko">
        사건
      </span>

      <span class="menu-en">
        CASE FILE
      </span>

    </button>


    <button
      class="menu"
      onclick="showScreen('archive')"
    >

      <span class="menu-number">
        04
      </span>

      <span class="menu-ko">
        기록
      </span>

      <span class="menu-en">
        ARCHIVE
      </span>

    </button>

  </div>

</section>



<!-- =========================================
     ROSTER
========================================= -->

<section
  id="roster"
  class="screen page"
>

  <header class="topbar">

    <div class="brand-small">
      PERSONNEL REGISTRY
    </div>

    <div class="system">
      FIELD TEAM 01 / 反影
    </div>

  </header>


  <h2 class="page-title">
    인물 기록
  </h2>

  <div class="page-description">
    현장부 1조 「반영」 등록 인원
  </div>


  <div class="roster">


    <!-- 애연 -->

    <button class="agent">

      <div class="portrait">
        愛
      </div>

      <div class="agent-info">

        <div class="agent-type">
          白虎 · 金 · 日脈
        </div>

        <div class="agent-name">
          愛緣 · 애연
        </div>

        <div class="agent-real">
          Robert Boniek
        </div>

      </div>

    </button>



    <!-- 단정 -->

    <button class="agent">

      <div class="portrait">
        單
      </div>

      <div class="agent-info">

        <div class="agent-type">
          黃龍 · 土 · 月脈
        </div>

        <div class="agent-name">
          單錠 · 단정
        </div>

        <div class="agent-real">
          설재영
        </div>

      </div>

    </button>



    <!-- 천하 -->

    <button class="agent">

      <div class="portrait">
        川
      </div>

      <div class="agent-info">

        <div class="agent-type">
          玄武 · 水 · 月脈
        </div>

        <div class="agent-name">
          川河 · 천하
        </div>

        <div class="agent-real">
          허중현
        </div>

      </div>

    </button>



    <!-- 유희 -->

    <button class="agent">

      <div class="portrait">
        由
      </div>

      <div class="agent-info">

        <div class="agent-type">
          朱雀 · 火 · 日脈
        </div>

        <div class="agent-name">
          由嬉 · 유희
        </div>

        <div class="agent-real">
          Javier Márquez
        </div>

      </div>

    </button>



    <!-- 수성 -->

    <button class="agent">

      <div class="portrait">
        收
      </div>

      <div class="agent-info">

        <div class="agent-type">
          靑龍 · 木 · 日脈
        </div>

        <div class="agent-name">
          收成 · 수성
        </div>

        <div class="agent-real">
          명세하
        </div>

      </div>

    </button>


  </div>


  <div class="back">

    <button
      class="back-btn"
      onclick="showScreen('lobby')"
    >
      ← BACK
    </button>

  </div>

</section>



<!-- =========================================
     FORMATION
========================================= -->

<section
  id="formation"
  class="screen page"
>

  <header class="topbar">
    <div class="brand-small">
      FORMATION
    </div>
  </header>

  <div class="placeholder">
    FORMATION SYSTEM / PREPARING
  </div>

  <div class="back">

    <button
      class="back-btn"
      onclick="showScreen('lobby')"
    >
      ← BACK
    </button>

  </div>

</section>



<!-- =========================================
     CASE
========================================= -->

<section
  id="case"
  class="screen page"
>

  <header class="topbar">
    <div class="brand-small">
      CASE FILE
    </div>
  </header>

  <div class="placeholder">
    CASE SYSTEM / PREPARING
  </div>

  <div class="back">

    <button
      class="back-btn"
      onclick="showScreen('lobby')"
    >
      ← BACK
    </button>

  </div>

</section>



<!-- =========================================
     ARCHIVE
========================================= -->

<section
  id="archive"
  class="screen page"
>

  <header class="topbar">
    <div class="brand-small">
      ARCHIVE
    </div>
  </header>

  <div class="placeholder">
    ARCHIVE SYSTEM / PREPARING
  </div>

  <div class="back">

    <button
      class="back-btn"
      onclick="showScreen('lobby')"
    >
      ← BACK
    </button>

  </div>

</section>



<script>

/* =========================================
   화면 전환
========================================= */

function showScreen(screenId) {

  const screens =
    document.querySelectorAll(".screen");


  screens.forEach(function(screen) {

    screen.classList.remove("active");

  });


  const target =
    document.getElementById(screenId);


  target.classList.add("active");


  window.scrollTo(0, 0);

}

</script>


</body>
</html>
