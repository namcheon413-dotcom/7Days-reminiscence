const titleBgm =
  document.getElementById("title-bgm");

const clickSfx =
  document.getElementById("click-sfx");


/* ==============================
   초기 볼륨
============================== */

titleBgm.volume = 0.5;

clickSfx.volume = 0.7;



/* ==============================
   BGM 재생
============================== */

async function playTitleBgm() {

  if (!titleBgm.paused) {
    return;
  }

  try {

    await titleBgm.play();

  } catch (error) {

    /*
      브라우저가 자동재생을 차단한 경우.
      첫 사용자 입력 때 main.js가 다시 시도한다.
    */

    console.log(
      "BGM autoplay blocked."
    );

  }

}



/* ==============================
   CLICK SFX
============================== */

function playClickSound() {

  clickSfx.currentTime = 0;

  clickSfx.play().catch(() => {});

}



/* ==============================
   페이지 로드 시 BGM 시도
============================== */

window.addEventListener(
  "load",
  playTitleBgm
);
